/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],

    // The Angular builder compiles and bundles with esbuild; tsc is only ever
    // used here to type-check. Without this, a plain `tsc -b` would scatter
    // .js files next to the sources, since this project has no outDir.
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
