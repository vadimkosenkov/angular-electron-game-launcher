{
  "name": "game-launcher",
  "productName": "Game Launcher",
  "description": "Desktop catalog of browser games built with Angular, Electron and Express.",
  "version": "0.0.0",
  "private": true,
  "main": "dist-node/electron/main.js",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:browser",
    "start:browser": "ng serve --open",
    "start:electron": "concurrently -k -n angular,tsc,electron -c cyan,yellow,green \"ng serve\" \"npm run watch:node\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:4300 dist-node/electron/main.js && electron dist-node/electron/main.js --dev",
    "build": "npm run build:web && npm run build:node",
    "build:web": "ng build",
    "build:node": "tsc -p tsconfig.node.json",
    "watch:node": "tsc -p tsconfig.node.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  }
}
